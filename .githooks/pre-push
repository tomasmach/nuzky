#!/bin/sh
# Checks unpushed commits before they reach GitHub: no secrets, and no video or audio files.
# Test media are generated by scripts/fixtures.sh; a committed clip may be someone's private video.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed. Install gitleaks 8.30.1 (https://github.com/gitleaks/gitleaks/releases) and push again." >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote branch pushes no commits.
  [ "$local_sha" = "$zero" ] && continue
  gitleaks git --redact=100 --no-banner --log-opts="$local_sha --not --remotes" . || exit 1
  # Unquoted names, so "něčí-video.mp4" ends in .mp4; names with quotes or control characters stay quoted.
  media=$(git -c core.quotePath=false log --format= --name-only --diff-filter=AR "$local_sha" --not --remotes |
    grep -iE '\.(mp4|mov|m4v|mkv|webm|avi|mts|wav|mp3|m4a|aac|flac|ogg|opus|heic)"?$' | sort -u |
    # The sounds built into Nuzky are CC0, each listed with its author and source in their manifest.
    while read -r file; do
      case "$file" in
        assets/sounds/*/*) ;;
        assets/sounds/*.ogg) grep -qF "\"file\": \"${file#assets/sounds/}\"" assets/sounds/manifest.json 2>/dev/null && continue ;;
      esac
      printf '%s\n' "$file"
    done)
  if [ -n "$media" ]; then
    echo "pre-push: these commits add video or audio files. Generate test media with scripts/fixtures.sh instead:" >&2
    echo "$media" >&2
    exit 1
  fi
done
